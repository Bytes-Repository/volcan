[package]
-> name        => volcan
-> version     => 0.1.0
-> description => Produkcyjny szkielet do pisania kompozytorow Wayland w H# - odpowiednik rustowego smithay, w 100% napisany w H#
-> author      => Bytes Developers
-> license     => MIT

[build]
-> lang   => h#
-> entry  => src/volcan.h#
-> output => build/libvolcan

[deps]
-> libc          => dynamic
-> wayland-server => dynamic   ;; trzymane jako dokumentacja ABI / ścieżka hybrydowa (patrz ffi/wayland_server.h#)
-> drm            => dynamic
-> gbm            => dynamic
-> EGL            => dynamic
-> GLESv2         => dynamic
-> input          => dynamic
-> xcb            => dynamic
-> udev           => dynamic
-> xkbcommon      => dynamic
-> seat           => dynamic   ;; libseat (patrz ffi/libseat.h# — częściowo zablokowane, patrz komentarz w pliku)

[runtime]
-> xwayland_binary => "Xwayland"
