pub const GL_TEXTURE_2D:        int = 0x0DE1
pub const GL_TEXTURE_EXTERNAL_OES: int = 0x8D65
pub const EGL_LINUX_DMA_BUF_EXT: int = 0x3270
pub const GL_TRIANGLE_STRIP: int = 0x0005
