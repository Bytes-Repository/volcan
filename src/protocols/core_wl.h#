pub fn wl_display_interface() -> wire::WireInterface is
    return wire::WireInterface {
        name: "wl_display", version: 1,
        requests: [
            wire::wire_msg("sync",        "n"),
            wire::wire_msg("get_registry","n"),
        ],
        events: [
            wire::wire_msg("error",       "ous"),
            wire::wire_msg("delete_id",   "u"),
        ],
