;; Pełny zestaw rdzennych interfejsów, do przekazania w jednym
;; wywołaniu `wire::build_protocol_set` (dwuprzebiegowe dowiązanie
;; `types` — patrz protocols/wire.h#).
pub fn all_core_interfaces() -> [wire::WireInterface] is
    return [
        wl_display_interface(), wl_registry_interface(), wl_callback_interface(),
        wl_compositor_interface(), wl_surface_interface(), wl_region_interface(),
        wl_shm_pool_interface(), wl_shm_interface(), wl_buffer_interface(),
        wl_output_interface(), wl_seat_interface(), wl_pointer_interface(),
        wl_keyboard_interface(), wl_touch_interface(),
        wl_data_device_manager_interface(),
        wl_subcompositor_interface(), wl_subsurface_interface(),
    ]
end
