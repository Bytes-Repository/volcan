;; xdg-decoration (server-side vs client-side dekoracje okien) — mały,
;; ale krytyczny protokół dla kompozytorów rysujących własne paski tytułu.
pub fn xdg_decoration_manager_interface() -> wire::WireInterface is
    return wire::WireInterface {
        name: "zxdg_decoration_manager_v1", version: 1,
        requests: [
            wire::wire_msg("destroy",             ""),
            wire::wire_msg_typed("get_toplevel_decoration", "no", ["zxdg_toplevel_decoration_v1", "xdg_toplevel"]),
        ],
        events: [],
    }
end

pub fn xdg_toplevel_decoration_interface() -> wire::WireInterface is
    return wire::WireInterface {
        name: "zxdg_toplevel_decoration_v1", version: 1,
        requests: [
            wire::wire_msg("destroy",     ""),
            wire::wire_msg("set_mode",    "u"),
            wire::wire_msg("unset_mode",  ""),
        ],
        events: [ wire::wire_msg("configure", "u") ],
    }
end

;; Pełny zestaw xdg-shell — te interfejsy odwołują się do siebie
;; nawzajem w obie strony (xdg_surface <-> xdg_toplevel/xdg_popup),
;; więc MUSZĄ być budowane przez `wire::build_protocol_set` (dwa
;; przebiegi), a nie pojedynczo przez `interface_ptr`.
pub fn all_xdg_interfaces() -> [wire::WireInterface] is
    return [
        xdg_wm_base_interface(), xdg_positioner_interface(),
        xdg_surface_interface(), xdg_toplevel_interface(), xdg_popup_interface(),
        xdg_decoration_manager_interface(), xdg_toplevel_decoration_interface(),
    ]
end
