pub fn xdg_wm_base_interface() -> wire::WireInterface is
    return wire::WireInterface {
        name: "xdg_wm_base", version: 6,
        requests: [
            wire::wire_msg("destroy",          ""),
            wire::wire_msg_typed("create_positioner","n", ["xdg_positioner"]),
            wire::wire_msg_typed("get_xdg_surface",  "no", ["xdg_surface", "wl_surface"]),
            wire::wire_msg("pong",             "u"),
        ],
        events: [ wire::wire_msg("ping", "u") ],
    }
end

